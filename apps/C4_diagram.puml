@startuml SmartHomeContext
!include ../C4_Context.puml

title Контекстная диаграмма C4 — Система "Умный дом"

Person(user, "Пользователь", "Просматривает температуру и состояние датчиков")
Person(admin, "Администратор", "Добавляет, изменяет и удаляет датчики")

System(smartHome, "Монолитное приложение «Умный дом»", "Предоставляет rest api для мониторинга температуры и управления датчиками")

SystemDb_Ext(database, "PostgreSQL", "Хранит сведения о датчиках и показания")
System_Ext(sensors, "Физические датчики температуры", "Измеряют температуру в помещениях")

Rel(user, smartHome, "Просматривает температуру и состояние датчиков", "http/json")
Rel(admin, smartHome, "Управляет датчиками: добавить, удалить, обновить", "http/json")

Rel(smartHome, database, "Читает и изменяет информацию по датчикам")

Rel(sensors, smartHome, "Передают показания", "http/json")

SHOW_LEGEND()
@enduml